
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ventas | Salsamentaria Primavera</title>
  <link rel="stylesheet" href="css/main.css">
</head>

<body class="dashboard-page ventas-page">

  <!-- Menú lateral -->
  {% include "sidebar.njk" %}

  <div class="dashboard-layout">

    <!-- Encabezado del sistema -->
    {% include "header.njk" %}

    <main class="dashboard ventas">

      <!-- Título y botones -->
      <div class="ventas__encabezado">
        <div>
          <p class="dashboard__ruta">
            Salsamentaria Primavera / Ventas
          </p>
          <h1>Ventas</h1>
          <p>Registra y consulta las ventas de tu negocio.</p>
        </div>

        <div class="ventas__botones">
          <button id="exportarVentas"
                  class="ventas__boton-secundario"
                  type="button">
            <i data-lucide="download"></i>
            Exportar
          </button>

          <a href="nueva-venta.html"
             class="ventas__boton-principal">
            <i data-lucide="shopping-cart"></i>
            Nueva venta
          </a>
        </div>
      </div>

      <!-- Indicadores -->
      <section class="ventas__indicadores">
        <article>
          <span>Ventas de hoy</span>
          <strong id="ventasHoy">$0</strong>
        </article>

        <article>
          <span>Transacciones</span>
          <strong id="transaccionesHoy">0</strong>
        </article>

        <article>
          <span>Venta promedio</span>
          <strong id="ventaPromedio">$0</strong>
        </article>

        <article>
          <span>Ventas a crédito</span>
          <strong id="ventasCredito">$0</strong>
        </article>
      </section>

      <!-- Buscador y filtros -->
      <div class="ventas__filtros">

        <label class="ventas__busqueda">
          <i data-lucide="search"></i>
          <input id="buscarVenta"
                 type="search"
                 placeholder="Buscar venta o cliente...">
        </label>

        <select id="filtroFecha"
                aria-label="Filtrar ventas por fecha">
          <option value="hoy">Hoy</option>
          <option value="ayer">Ayer</option>
          <option value="semana">Esta semana</option>
          <option value="todos">Todas las fechas</option>
        </select>

        <select id="filtroPago"
                aria-label="Filtrar por medio de pago">
          <option value="todos">Medio de pago</option>
          <option value="efectivo">Efectivo</option>
          <option value="transferencia">Transferencia</option>
          <option value="credito">Crédito</option>
        </select>

      </div>

      <!-- Tabla de ventas -->
      <section class="ventas__tarjeta">
        <div class="ventas__tabla-scroll">
          <table class="ventas__tabla">
            <thead>
              <tr>
                <th>VENTA</th>
                <th>CLIENTE</th>
                <th>FECHA</th>
                <th>MEDIO DE PAGO</th>
                <th>TOTAL</th>
                <th>ACCIONES</th>
              </tr>
            </thead>

            <tbody id="tablaVentas"></tbody>
          </table>
        </div>

        <p id="sinVentas"
           class="ventas__sin-resultados"
           hidden>
          No se encontraron ventas.
        </p>

        <!-- Paginación -->
        <div class="ventas__pie">
          <span id="textoPaginacionVentas"></span>
          <div id="paginacionVentas"
               class="ventas__paginacion"></div>
        </div>
      </section>

    </main>
  </div>

  <!-- Ventana para consultar una venta -->
  <dialog id="detalleVenta" class="ventas__dialogo">
    <div class="ventas__dialogo-encabezado">
      <h2>Detalle de la venta</h2>
      <button id="cerrarDetalle"
              type="button"
              aria-label="Cerrar detalle">
        <i data-lucide="x"></i>
      </button>
    </div>

    <div id="contenidoDetalle"></div>
  </dialog>

  <div class="dashboard-overlay"
       id="dashboardOverlay"></div>

  <script src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js"></script>
  <script src="js/dashboard.js"></script>
  <script src="js/navegacion.js"></script>
  <script src="js/ventas.js"></script>
</body>
</html>
