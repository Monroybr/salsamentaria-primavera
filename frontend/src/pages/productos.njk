{% extends "base.njk" %}

{% block titulo %}
Productos | Salsamentaria Primavera
{% endblock %}

{% block clase_body %}productos-page{% endblock %}

{% block contenido %}

<main class="dashboard productos">

  <!-- ENCABEZADO -->
  <div class="productos__encabezado">

    <div>
      <p class="dashboard__ruta">
        Salsamentaria Primavera / Productos
      </p>

      <h1>Productos</h1>

      <p>
        Administra el catálogo y sus presentaciones.
      </p>
    </div>

    <a
      href="nuevo-producto.html"
      class="dashboard__nueva-venta"
    >
      <i data-lucide="plus" aria-hidden="true"></i>
      <span>Nuevo producto</span>
    </a>

  </div>

  <!-- FILTROS -->
  <div class="productos__filtros">

    <label class="productos__busqueda">

      <i data-lucide="search" aria-hidden="true"></i>

      <input
        type="search"
        id="buscarProducto"
        placeholder="Buscar por nombre, categoría o código..."
        aria-label="Buscar productos"
      >

    </label>

    <select
      id="filtroCategoria"
      aria-label="Filtrar por categoría"
    >
      <option value="todos">
        Todas las categorías
      </option>
    </select>

    <select
      id="filtroEstado"
      aria-label="Filtrar por estado"
    >
      <option value="todos">Todos los estados</option>
      <option value="disponible">Disponible</option>
      <option value="bajo">Stock bajo</option>
      <option value="inactivo">Inactivo</option>
    </select>

  </div>

  <!-- LISTADO DE PRODUCTOS -->
  <section
    class="productos__tarjeta"
    aria-label="Listado de productos"
  >

    <div class="productos__tabla-scroll">

      <table class="productos__tabla">

        <thead>
          <tr>
            <th>PRODUCTO</th>
            <th>CÓDIGO</th>
            <th>CATEGORÍA</th>
            <th>EXISTENCIAS</th>
            <th>PRECIO DE VENTA</th>
            <th>ESTADO</th>
            <th>ACCIONES</th>
          </tr>
        </thead>

        <tbody id="tablaProductos">
          <!-- Los productos se cargan desde MySQL -->
        </tbody>

      </table>

    </div>

    <!-- MENSAJE SIN RESULTADOS -->
    <p
      class="productos__sin-resultados"
      id="sinResultados"
      hidden
    >
      No se encontraron productos con esos filtros.
    </p>

    <!-- PAGINACIÓN -->
    <div class="productos__paginacion">

      <span id="resumenProductos">
        Cargando productos...
      </span>

      <nav
        class="productos__paginas"
        id="paginacionProductos"
        aria-label="Paginación de productos"
      ></nav>

    </div>

  </section>

</main>

{% endblock %}

{% block scripts %}

<!-- Funciones del módulo Productos -->
<script src="js/auth.js"></script>
<script src="js/productos.js"></script>

{% endblock %}
