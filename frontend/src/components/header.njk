<!-- ==========================================
     BARRA SUPERIOR
     SALSAMENTARIA PRIMAVERA
========================================== -->

<header class="header">

  <button
    class="header__menu"
    id="btnMenu"
    type="button"
    aria-label="Abrir menú"
    aria-controls="sidebar"
    aria-expanded="false"
  >
    ☰
  </button>

  <div class="header__acciones">

    <input
      type="search"
      placeholder="Buscar en el sistema..."
      aria-label="Buscar en el sistema"
      class="header__buscar"
    >

    <button
      type="button"
      class="header__notificaciones"
      aria-label="Notificaciones"
    >
      ♧
    </button>

    <!-- Avatar del usuario autenticado -->
    <div
      class="header__avatar"
      id="avatarHeaderUsuario"
      title="Usuario autenticado"
    >
      --
    </div>

  </div>

</header>
